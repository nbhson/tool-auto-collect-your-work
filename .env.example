# ─── Server ──────────────────────────────────────────
HOST=127.0.0.1
PORT=8765
DEBUG=true

# ─── Database ────────────────────────────────────────
DATABASE_URL=sqlite:///./worklog.db

# ─── Jira (để trống nếu chưa dùng) ──────────────────────
# Jira Cloud REST API v3:
#   JIRA_URL=https://your-domain.atlassian.net
#   JIRA_EMAIL=your-email@example.com
#   JIRA_API_TOKEN=your-jira-api-token  → tạo tại https://id.atlassian.com/manage/api-tokens
#   JIRA_PROJECT=PROJ                    → project key (vd: SP0168)
#   JIRA_POLL_INTERVAL_MINUTES=10        → bao lâu poll 1 lần
#
# Poller collect: status_change, comment, assignee_change, estimation_change,
#                 ticket_update (summary/description/priority changes)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT=PROJ
JIRA_POLL_INTERVAL_MINUTES=10

# ─── Bitbucket (để trống nếu chưa dùng) ─────────────────
# Hỗ trợ cả Bitbucket Cloud và Bitbucket Server/Data Center
#
# Bitbucket Server — dùng URL của project:
#   BITBUCKET_WORKSPACE=https://your-bitbucket-server.com/projects/PROJ_KEY
#   BITBUCKET_USERNAME=your-username
#   BITBUCKET_APP_PASSWORD=your-password
#
# Bitbucket Cloud — dùng workspace slug:
#   BITBUCKET_WORKSPACE=your-workspace
#   BITBUCKET_USERNAME=your-username
#   BITBUCKET_APP_PASSWORD=your-app-password
BITBUCKET_USERNAME=your-bitbucket-username
BITBUCKET_APP_PASSWORD=your-app-password
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_POLL_INTERVAL_MINUTES=10

# ─── GitHub Models ───────────────────────────────────
# Token để dùng GitHub Models API (https://github.com/marketplace/models)
# GITHUB_TOKEN=ghp_your-github-token
# GITHUB_BASE_URL=https://models.inference.ai.azure.com

# ─── GitHub Poller ────────────────────────────────────
# Token để auto-collect commits, PRs, issues từ GitHub
# Cần Personal Access Token với repo + read:org scopes
# GITHUB_POLL_INTERVAL_MINUTES=10

# ─── Git hooks log file ──────────────────────────────
# File mà post-commit hook sẽ ghi vào (mặc định: ~/.worklog_git_hooks.jsonl)
# GIT_HOOK_LOG=~/.worklog_git_hooks.jsonl
